# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:4:162
# text_orig = S. José anhunten i-manhanaçára reté, i-çapeiára reté iuïri.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:5:163
# text_orig = U-cemo ramé, angaîntá u-iuquau apgauaîtá çupé u-manhana uahá-itá u-icú mimbaua; aîta u-nheen aîta çupé: — Ia-umbeú peinhé arama iepé marandua poranga rété; u-cemo-uana Messias upainhen miraîtá uçaárú reté uahá humanidade Piciruçára arama.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:6:164
# text_orig = Cucecui çangaua ia-mehen uahá pe-quau arama: — Pe-çú Belem kiti.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:7:165
# text_orig = Ape pe-uacemo iepé taina unhenun i-manha iuhá arupi, panno miritá piterpe, iepé çúúitá ruca-miri upé.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:8:166
# text_orig = U-nheen pau riré qua-îtá, angaîtá u-nhengari: — Gloria Tupana Iuáca upé; catuçaua iké iuhipe catú remutára miraîtá çupé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:9:167
