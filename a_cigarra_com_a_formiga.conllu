# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:22:180
# text_orig = Magoîtá u-çú, aramé u-iuquau iuïri iacitátá mahá-uahá puraçú u-icú aîtá té Belem, u-pitá mamé u-icú uahá taina.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:23:181
# text_orig = U-cica ramé, aîtá uacemo taina i-manha iuhá arupi; aîtá adorari iuïri aé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:24:182
# text_orig = Ariré iepé anga u-nheen aîtá çupé ti arama u-iuiri Jerusalem rupi; aramé aîtá u-iuiri Retama kiti amú pé rupi.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:25:183
# text_orig = Muruixaua Herodes u-mahan ramé ti Magoîtá u-iuquau ipiáhïua reté; u-mundú i-çuráraîtá u-çú u-iucá pau muiri tanaîtá uacemo Belem upé, uricúana uahá mucúim acaiú iuirakiti, umaité aramé u-iucá Taina Iesus.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:26:184
# text_orig = Iépé anga u-iuquau S. José çupé ikerpiçaua upé pituna pucuçaua, u-mundú aé u-çú-ana Egypto kiti Taina irumo i-manha iuïri.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:27:185
# text_orig = José u-páca ramé u-çú-ana ieperecê Egypto kiti Taina irumo i-manha iuïri.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:28:186
# text_orig = Ape u-pitá té mairamé u-manú-ana muruixaua Herodes.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:29:187
# text_orig = Aramé u-iuquau amú hi iepé anga, unheen: — Re-iuiri quau uana cetama kiti, maharecê u-manú-ana u-cicari uahá itá u-iucá arama Taina Jesus.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:30:188
# text_orig = S. José ieperecê u-iuiri cetama kiti, u-pitá Nazareth upé, mamé u-puraiki carapina rupi.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:31:189
# text_orig = Ape u-requé Iané Iára Iesu Christu pú iepé pú acaiú pucuçaua mahiê carapina tenhunto iaué; u-puraiki i-pú rupi reté, u-munhan upainhen José, Maria remutára, u-mucamehen arama mahiê ia-puraiki quau u-mbaú arama iané riaiçaua irumo, ia-munhan iuïri iané paiaîtá remutára.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:32:190
# text_orig = Pú iepé pú acaiú riré u-çú-ana paraná Jordão kiti mamé u-iu-muceruca S. João Baptista rupi.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:33:191
# text_orig = U-iu-muceruca uahá upé tenhen iuáca u-iu-pirari, u-iuquau Espirito Santo, picaçú iaué, uié, uapica iacanga arupi, aramé u-iuquau iepé nheenga u-nheen: — Qua ce Rahira xa-çaiçú rété uahá.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:34:192
# text_orig = U-iu-mucerúca pau riré, Iané Iára Iesu Christu u-tirica uana miraima uahá kiti, mamé u-iuquaçú 40 ara, 40 pituna pucú rupi.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:35:193
# text_orig = U-iuquaçú pau riré u-iupirú umbué upainhen rupi.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:36:194
# text_orig = U-paráuaca i 12 (mucuim pú mucuim) apostoritá; iatiri aîtá irumo uatá upainhen Judéa turuçúçaua.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:37:195
# text_orig = U-munhan cetá milagritá.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:38:196
# text_orig = U-muiuiri ceçá ceçámaîtá çupé; u-munhan uatá iaparaitá; um-puçanga pereuamanha; u-iupui mucúim hi miraima uahá upé 4 mil miraîtá piri çui 5 miapé irumo, mucuim pirá iuïri; umbaca muçapiri tiãoera.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:39:197
# text_orig = Pauçape uatá muçapiri acaiú u-munhan upainhen catuçauaîtá upainhen rupi, umbué poranga piri mahan ia-manduari uahá. 
# text_source = p. 174
# text_sec = 
