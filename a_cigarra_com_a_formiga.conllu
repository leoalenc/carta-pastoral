# sent_id = Costa1909:6:1:159
# text_orig = Iesu Christu, Tupana Rahira, Santissima Trindade Mucuimçaua Pessoa, Iané Piciruçára, u-icú qua mundo opé 33 acaiú, muçapiri iaci arupi rupi.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:2:160
# text_orig = Aé u-cemo Belem upé, Iudéa maïri-miri, iepé çúúîtá ruca-miri upé, 25 ara, Dezembro iaci, ia-ceruca Natal ara.
# text_source = p. 172
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:3:161
# text_orig = I manha aé tenhen Virgem Maria, Iané Iára, Espirito Santo graça rupi, u-pitá upain ara Virgem.
