# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:10:168
# text_orig = Mimbauamanhanaçaraîtá u-çú  Belem kiti, uacemo upainhen mahiê angaîtá umbeú uahá iaué.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:11:169
# text_orig = Aramé aîtá u-iunipian taina ruaxára, u-adorari-uana aé.
