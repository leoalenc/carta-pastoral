# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:21:179
# text_orig = Pe-adorari pau riré; pe-iuiri, pembeú ixé arama, a-çú putari ixé iuïri adorari aé.
