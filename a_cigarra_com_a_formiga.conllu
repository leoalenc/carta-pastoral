# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:2:39:77
# text_orig = Umahan iuïri Iurupari ti u-çaçau mamé u-icú uahá curuçá.
