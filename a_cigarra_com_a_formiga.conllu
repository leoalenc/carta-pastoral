# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:12:170
# text_orig = Aramé tenhen iuïri u-iuquau iepé iacitátá turuçú, poranga, Curaci ra-pé çui, muçapiri Magos muruixauaîtá çupé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:13:171
# text_orig = Aîtá u-mahan pau riré iacitátá u-nheen: — U-cemo-uana Judeoîtá muruixaua.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:14:172
# text_orig = Ia-çú-ana iadorari aé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:15:173
# text_orig = Ieperecê u-çú-ana Belem kiti rimiaçuaîtá irumo, mimbauaîtá, upainhen mahan iuïri u-mehen arama Taina Tupana Rahira çupé.
# text_source = p. 173
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:16:174
# text_orig = Iacitátá uatá u-çú u-icú aîtá renundé té Jerusalem mamé u-cahemo.
