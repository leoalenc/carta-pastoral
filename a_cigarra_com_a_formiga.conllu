# sent_id = Costa1909:1:1:1
# text_orig = Daridari u-nhengari rété curaci ara pucuçaua.
# text_source = p. 165
# text_sec = Daridari u-nhengari reté curaci ara pucusáua.
# text_sec_source = Stradelli (1928:736)
# text_por = A cigarra cantou muito durante o verão.
# text_por_source = Stradelli (1928:736)
# title_orig = Daridari Tacïua irumo Marandaua
# title_por_sec = A cigarra com a formiga. Conto

# sent_id = Costa1909:1:2:2
# text_orig = U-munhan muracê ara iaué iaué.
# text_source = p. 165
# text_sec = U-munhana murace ara iaué iaué.
# text_sec_source = Stradelli (1928:736)
# text_por = Dançou todo tempo.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:3:3
# text_orig = U-mbaú-ana, u-ú pau ana irumuaraîtá irumo.
# text_source = p. 165
# text_sec = U-mbaú-ana, u-u pau-ana irumuraitá irumo.
# text_sec_source = Stradelli (1928:736)
# text_por = Comeu tudo, bebeu tudo com as companheiras.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:4:4
# text_orig = U-puracê ara pucuçaua, pituna pucuçaua.
# text_source = p. 165
# text_sec = U-puracé ara pucusáua, pituna pucusáua.
# text_sec_source = Stradelli (1928:736)
# text_por = Dançou todo o dia e toda a noite.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:5:5
# text_orig = U-mbaú-ana upainhen uricú uahá.
# text_source = p. 165
# text_sec = U-mbaú-ana upainhen uricú uaá.
# text_sec_source = Stradelli (1928:736)
# text_por = Comeu tudo o que tinha.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:6:6
# text_orig = Nemanungára umungatúru ariré uára.
# text_source = p. 165
# text_sec = Nemanungara u-mungaturú ariré uara.
# text_sec_source = Stradelli (1928:736)
# text_por = Não guardou nada para depois.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:7:7
# text_orig = Ucica amana ara çupi rupiára, iruçanga reté.
# text_source = p. 165
# text_sec = U-cica amana ara supi rupiara irusanga reté.
# text_sec_source = Stradelli (1928:736)
# text_por = Chega o tempo da chuva verdadeiro, por isso muito frio.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:8:8
# text_orig = Amana uaári muiri ara, nharacê ti auá umunhan quau muraiki.
# text_source = p. 165
# text_sec = Amana uaari muiri ara, nharacé ti auá umunhãn cuau muraiki;
# text_sec_source = Stradelli (1928:736)
# text_por = A chuva cae muitos dias, pelo que ninguem pode trabalhar.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:9:9
# text_orig = Aramé Daridari u-iumaci.
# text_source = p. 165
# text_sec = Aramé Daridarí u-iumaci, ti uricú manungara u-mbaú arama.
# text_sec_source = Stradelli (1928:736)
# text_por = Então Daridari tem fome, não tem nada para comer.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:10:10
# text_orig = Ti uricú manungára u-mbaú arama.
# text_source = p. 165
# text_sec = Aramé Daridarí u-iumaci, ti uricú manungara u-mbaú arama.
# text_sec_source = Stradelli (1928:736)
# text_por = Então Daridari tem fome, não tem nada para comer.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:11:11
# text_orig = Utim recêuára u-iurureu, kiririnto u-purará uicupucú rupi.
# text_source = p. 165
# text_sec = Utim receuára u-iurureu, kiririnto u-purará uicupucú rupi.
# text_sec_source = Stradelli (1928:736)
# text_por = Com vergonha de pedir, supportou calada por muito tempo.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:12:12
# text_orig = Umanú putari ramé uana, ucámirica imarica, nheen: — Tiana a-pitáçuca quau imaci.
# text_source = p. 165
# text_sec = Umanú putari ramé ana, ucamiricá imarica unheen: — Tiana apitasuca cuau iumaci.
# text_sec_source = Stradelli (1928:736)
# text_por = Quando já estava para querer morrer, apertando a barriga, disse: — Já não posso mais suportar a fome.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:13:13
# text_orig = Ti apuraiki putari curaci ara ramé, timaan puçanga cuhiri a-iurureu ti arama amanú.
# text_source = p. 165
# text_sec = Ti apuraiki putari curaci ara ramé, timaan pusanga cuiri aiurureu ti arama amanú.
# text_sec_source = Stradelli (1928:736)
# text_por = Não quiz trabalhar no tempo do sol, agora não ha remedio sinão pedir para não morrer.
# text_por_source = Stradelli (1928:736)

# sent_id = Costa1909:1:14:14
# text_orig = Auá çui tahá mahá?
# text_source = p. 165
# text_sec = Auá sui, taá, maá?
# text_sec_source = Stradelli (1928:737)
# text_por = A quem mais recorrer?
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:15:15
# text_orig = Ce anamaîtá upainhen u-munhan ce iaué.
# text_source = p. 165
# text_sec = Ce anamaitá upainhem u-munhãn ce iaué.
# text_sec_source = Stradelli (1928:737)
# text_por = Os meus parentes todos fizeram como eu.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:16:16
# text_orig = Upainhen u-nhengari curaci ara pucuçaua, cuhiri u-purará uicú iruçanga, uriri pau aîtá uicú.
# text_source = p. 165
# text_sec = — Upainhen u-nhengari curaci pucusáua, cuiri u-purará u-icú irusanga, u-riri pau aitá u-icú. 
# text_sec_source = Stradelli (1928:737)
# text_por = — Todos cantaram muito durante o verão, agora estão suportando o frio, todos estão tremendo.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:17:17
# text_orig = U-kiriri u-manduari.
# text_source = p. 165
# text_sec = Ukiriri umanduari, upucú xinga riré onheen: — Timaan pusanga!
# text_sec_source = Stradelli (1928:737)
# text_por = Calou-se, pensou, depois de pouco disse: — Não ha remedio!
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:18:18
# text_orig = Upucú xinga riré unheen: — Timaan puçanga.
# text_source = p. 165
# text_sec = Ukiriri umanduari, upucú xinga riré onheen: — Timaan pusanga!
# text_sec_source = Stradelli (1928:737)
# text_por = Calou-se, pensou, depois de pouco disse: — Não ha remedio!
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:19:19
# text_orig = Cuhiri a-çú a-tucátucá ce comadre tacïua ukena.
# text_source = p. 165
# text_sec = Cuiri a-su atucátucá ce comadre taxyua okena.
# text_sec_source = Stradelli (1928:737)
# text_por = Agora eu vou bater á porta da minha comadre formiga.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:20:20
# text_orig = A-quau catú curi puxi u-çuainti ixé.
# text_source = p. 165
# text_sec = A-cuau catú curi puxi usuainti ixé.
# text_sec_source = Stradelli (1928:737)
# text_por = Não sei si me receberá bem ou mal.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:21:21
# text_orig = Mã, maita mahá u-munhan?
# text_source = p. 165
# text_sec = Mã maita maá u-munhãn?
# text_sec_source = Stradelli (1928:737)
# text_por = Mas o que fazer?
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:22:22
# text_orig = Ce piraçuaçaua iaué u-mundú.
# text_source = p. 165
# text_sec = Ce pirasuasáua iaué u-mundú.
# text_sec_source = Stradelli (1928:737)
# text_por = A minha desgraça assim o manda.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:23:23
# text_orig = Quaié u-nheen pau riré u-iu-muhamundéo; u-çú-ana çatambica tacïua ruca kiti apecatú xinga uicú uahá açui.
# text_source = p. 165
# text_sec = Cuaié u-nheen pau riré u-iu-munhamundeo; u-su-ana satambica tacyua ruca kiti apecatú xinga uicú uaá asui.
# text_sec_source = Stradelli (1928:737)
# text_por = Acabou de dizer assim, depois ataviou-se; foi direto para casa da formiga, que morava um pouco longe d'ahi.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:24:24
# text_orig = U-tucátucá ukena ucikieçaua rupi.
# text_source = p. 165
# text_sec = U-tucátucá okeiua ucikiésáua rupi.
# text_sec_source = Stradelli (1928:737)
# text_por = Batteu na porta com medo.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:25:25
# text_orig = Tacïua uri u-pirari ukena, u-nheen: — Mahiê-tahá, comadre Daridari?
# text_source = p. 165
# text_sec = Taxyua uri u-pirari okena onheen: — Maie-taa, comadre Daridari?
# text_sec_source = Stradelli (1928:737)
# text_por = A formiga vindo abrir a porta disse: — Que é isso, comadre Daridari?
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:26:26
# text_orig = Mahá marandua u-ruri indé ce ruca kiti?
# text_source = p. 165
# text_sec = Maá marandua ururi indé ce roca kiti?
# text_sec_source = Stradelli (1928:737)
# text_por = Que novidade traz você á minha casa?
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:27:27
# text_orig = Daridari utimçaua rupi u-çuaxára: — Ah comadre!
# text_source = p. 165
# text_sec = Daridari utinsáua rupi u-suaxára: — Ah comadre!
# text_sec_source = Stradelli (1928:737)
# text_por = Daridari com vergonha respondeu: — Ah comadre!
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:28:28
# text_orig = A-muaci reté a-nheen indé arama: ixé a-manú a-icú iumaci rupi.
# text_source = p. 165
# text_sec = A-muaci reté anheen indé arama, ixé amanú aicú iumaci rupi.
# text_sec_source = Stradelli (1928:737)
# text_por = Eu sofro muito, o digo para ti, eu estou a morrer de fome.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:29:29
# text_orig = A-iuri a-púrú ne çui mahã miri ixé arama familia irumo.
# text_source = p. 165
# text_sec = A-iuri a-puru ne suí maã miri ixé arama familia irumo.
# text_sec_source = Stradelli (1928:737)
# text_por = Venho emprestar de ti qualquer pequena cousa para mim e minha familia.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:30:30
# text_orig = Tupana recê catú!
# text_source = p. 165
# text_sec = Tupana recé catú!
# text_sec_source = Stradelli (1928:737)
# text_por = Si Deus quizer!
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:31:31
# text_orig = Agosto iaci renundé xa-pagari curi upainhen.
# text_source = p. 165
# text_sec = agosto iaci tenendé xa-pagari curi upainhen.
# text_sec_source = Stradelli (1928:737)
# text_por = com a lua de Agosto eu poderei pagar tudo.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:32:32
# text_orig = Tacïua catú reté; mã çupi ti-upuruêra.
# text_source = p. 165
# text_sec = Taxyua catú reté, ma supi tiupuruéra.
# text_sec_source = Stradelli (1928:737)
# text_por = A formiga é muito boa, na verdade não é emprestadeira.
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:33:33
# text_orig = Ucendú riré Daridari nheenga u-muxirica çuá, u-purandú: — Marama rericú iumaci?
# text_source = p. 165
# text_sec = U-cendú riré Daridari nheenga u-muxirica suá, u-purandú: — Marama rericu iumaci?
# text_sec_source = Stradelli (1928:737)
# text_por = Depois de ter ouvido a conversa de Daridari fechou a cara e perguntou: — Porque tu estás faminta?
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:34:34
# text_orig = Maha-tahá re-munhan curaci ara pucuçaua?
# text_source = p. 165
# text_sec = Maátaá remunhãn curaci ara pucusáua?
# text_sec_source = Stradelli (1928:737)
# text_por = Que fizeste durante o tempo do sol?
# text_por_source = Stradelli (1928:737)

# sent_id = Costa1909:1:35:35
# text_orig = Daridari u-çuaxára: — Mahá-tahá mahã u-çuaxára indé, comadre?
# text_source = p. 166
# text_sec = Daridari u-suaxara: — Maátaá ma u-suaxara indé, comadre?
# text_sec_source = Stradelli (1928:738)
# text_por = Daridari respondeu: — O que hei de responder-te, comadre?
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:1:36:36
# text_orig = A-nhengari, a-puracê iuïri nhaan ara pucuçaua.
# text_source = p. 166
# text_sec = A-nhengari, a-puracé iuyri nhaan ara pucusáua.
# text_sec_source = Stradelli (1928:738)
# text_por = Cantei e dancei durante todo este tempo.
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:1:37:37
# text_orig = — Aramé, u-çuaxára Tacïua, cuhiri comadre anhunten u-munhan quau.
# text_source = p. 166
# text_sec = — Aramé, usuaxara taxyua, cuiri, comadre, anhunten u-munhan cuau, re-iupirú re-puracé iuyri, merecé auá ti u-puraiki ti u-mbaú.
# text_sec_source = Stradelli (1928:738)
# text_por = — Então, respondeu a formiga, agora, comadre, o que somente podes fazer é recomeçar a dançar, porque quem não trabalha não come.
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:1:38:38
# text_orig = Re-iupirú re-puracê iuïri, maharecê auá ti u-puraiki ti u-mbaú.
# text_source = p. 166
# text_sec = — Aramé, usuaxara taxyua, cuiri, comadre, anhunten u-munhan cuau, re-iupirú re-puracé iuyri, merecé auá ti u-puraiki ti u-mbaú.
# text_sec_source = Stradelli (1928:738)
# text_por = — Então, respondeu a formiga, agora, comadre, o que somente podes fazer é recomeçar a dançar, porque quem não trabalha não come.
# text_por_source = Stradelli (1928:738)

