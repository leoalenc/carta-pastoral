# sent_id = Costa1909:6:40:198
# text_orig = U-nheen quaiaué: — Catú rété ti uricú manungára maharecê aé curi Iuáca iára.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:41:199
# text_orig = Catú rété auá u-purará maharecê çuri reté curi.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:42:200
# text_orig = Pe-iuri ixé arama peinhé u-purará uahá itá, ixé curi a-mururi curi peinhé.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:43:201
# text_orig = Ce Paia u-mundú ixé a-picirú arama piraçuaitá, pecadoritá iuïri.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:44:202
# text_orig = Pe-iu-çaiçú iepéuaçú mahiê ixé a-çaiçú peinhé.
# text_source = p. 174
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:45:203
# text_orig = Pe-mehen Cesar çupé mahan César Iára, Tupana çupé mahan Tupana Iára.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:46:204
# text_orig = Pe-çaiçú tenhen iuïri pe-ruanianaîtá, u-munhan catú iuïri auá púxi uahá u-munhan peinhé arama.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:47:205
# text_orig = Quaiaué umbué pau riré, iepé Apostoruitá çuiuára, Judas Iscariotes, u-mehen aé çuanianaitá çupé 30 dinheiros recuiára. 
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:48:206
# text_orig = Aramé aitá u-picica Iané Iára Iesu Christu horto Gethsemani upé, u-pucuari aé, u-cikiciki aé mahiê miraiucaçára iaué, u-munhan aé çupé upainhen catú puxiçaua.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:49:207
# text_orig = Ipauçaua upé u-raçú aé Poncio Piratos çupé u-iucáçari arama aé.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:50:208
# text_orig = Piratos u-mahan ti çatambica, ti u-putari.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:51:209
# text_orig = Aîtá cuité u-çacemo rété: — Ti ramé re-iucá qua intiana indé Cesar camarára.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:52:210
# text_orig = Piratos u-cikiê recêuára u-iucácari aé curuçá recê, mucúim mundauaçú piterpe; u-coatiaricári curuçá recê quaié: — Iesus Nazareuára Judeoitá Muruixaua.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:53:211
# text_orig = Iané Iára Iesu Christu curuçá upé u-purará Calvario huitêra; u-manú-ana çaciçaua riré muçapiri hora, iepé iuquaçú ara upé.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:54:212
# text_orig = U-manú riré i-discipuroitá u-iutima aé.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:55:213
# text_orig = Aé cuité u-cemo siqué iuhiquára çui.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:56:214
# text_orig = U-icú ranhen 40 ara pucuçaua iké iuhipe, u-iuquauiuquau amuramé discipuroitá çupé.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:57:215
# text_orig = Pauçaua 40 ara riré, u-muatiri anhun arama discipuroitá, u-mehen aîtá çupé benção, u-mundú aîtá u-çú mundo turuçúçaua umbué Evangelho.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:6:58:216
# text_orig = Ariré u-iupiri uana Iuáca kiti, mamé uapica uicú i-Paia catuçaua çui.
# text_source = p. 175
# text_sec = 
# text_sec_source = Stradelli (1928:738)
# text_por = 
# text_por_source = Stradelli (1928:738)

