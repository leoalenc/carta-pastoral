# text_por = 
# text_por_source = Stradelli (1928:738)

# sent_id = Costa1909:2:65:103
# text_orig = Re-servire putari Iesu Christu re-munhan ne ruca cachoeira ruaki, re-munhan arama catuçaua ne rapixaraîtá mira çupé, re-muiaçaiaçau amú çuaxára kiti auá u-cicá.
